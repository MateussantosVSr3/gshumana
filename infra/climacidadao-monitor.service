[Unit]
Description=Monitor ClimaCidadao
After=climacidadao.service
[Service]
Type=simple
User=climacidadao
Group=climacidadao
ExecStart=/usr/local/bin/climacidadao-monitor
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/log/climacidadao
[Install]
WantedBy=multi-user.target
